{
  "name": "@lurkwire/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lurkwire Electron shell",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "tsc --noEmit && vitest run",
    "typecheck": "tsc --noEmit",
    "dist:linux": "electron-builder --linux AppImage deb",
    "smoke": "LURKWIRE_SMOKE=1 electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.77.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "39.8.10",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "author": "Kritarth Agrawal <44940694+kritarth1107@users.noreply.github.com>",
  "homepage": "https://lurkwire.com",
  "build": {
    "appId": "com.lurkwire.app",
    "productName": "Lurkwire",
    "copyright": "Copyright © Kritarth Agrawal",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../../dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../target/release/lurkwire-proxy",
        "to": "lurkwire-proxy"
      }
    ],
    "afterPack": "./build/afterPack.cjs",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icons",
      "executableName": "lurkwire",
      "synopsis": "AI-native security browser with a built-in intercepting proxy",
      "description": "Lurkwire is an AI-native security browser with a built-in intercepting proxy, Repeater, and related tooling.",
      "desktop": {
        "entry": {
          "Name": "Lurkwire",
          "Comment": "AI-native security browser with a built-in intercepting proxy",
          "Type": "Application",
          "Terminal": "false",
          "Categories": "Network;Security;Development;",
          "StartupWMClass": "Lurkwire",
          "StartupNotify": "true",
          "Icon": "lurkwire"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "lurkwire",
      "priority": "optional",
      "artifactName": "lurkwire_${version}_${arch}.${ext}"
    },
    "electronVersion": "39.8.10",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico"
    }
  },
  "desktopName": "Lurkwire"
}
